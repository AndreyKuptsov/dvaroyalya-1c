// Модуль документа Посещение

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	ЗанятиеОбъект = Занятие.ПолучитьОбъект();
	ЗанятиеОбъект.Статус = Перечисления.СтатусыЗанятия.Проведено;
	ЗанятиеОбъект.Записать();

	// Списание занятий с абонементов и регистрация посещаемости
	НаборЗаписейПосещения = РегистрыНакопления.Посещения.СоздатьНаборЗаписей();
	НаборЗаписейПосещения.Отбор.Регистратор.Установить(Ссылка);
	НаборЗаписейПосещения.Записать();

	// Движения списания по остаткам абонементов
	ДвиженияОстатки = Новый Массив;

	Для Каждого СтрокаУчастников ИЗ Участники Цикл
		// Обновляем статус посещения в занятии
		Для Каждого УчастникЗанятия ИЗ ЗанятиеОбъект.Участники Цикл
			Если УчастникЗанятия.Клиент = СтрокаУчастников.Клиент Тогда
				УчастникЗанятия.СтатусПосещения = СтрокаУчастников.СтатусПосещения;
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Движение = НаборЗаписейПосещения.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Дата;
		Движение.Клиент = СтрокаУчастников.Клиент;
		Движение.Преподаватель = Преподаватель;
		Движение.Направление = ЗанятиеОбъект.Направление;

		Если СтрокаУчастников.СтатусПосещения = Перечисления.СтатусыПосещения.Присутствовал Тогда
			Движение.Присутствовал = 1;
		ИначеЕсли СтрокаУчастников.СтатусПосещения = Перечисления.СтатусыПосещения.Отсутствовал
			ИЛИ СтрокаУчастников.СтатусПосещения = Перечисления.СтатусыПосещения.ОтменилПоздно Тогда
			Движение.Отсутствовал = 1;
		КонецЕсли;

		// Списание занятия с абонемента (движение Расход по регистру ОстаткиАбонементов)
		Если СтрокаУчастников.СписатьЗанятие И Не ПустоеЗначение(СтрокаУчастников.Абонемент) Тогда
			Если РаботаСОстаткамиАбонементов.ОстатокЗанятийПоАбонементу(СтрокаУчастников.Абонемент) <= 0 Тогда
				ВызватьИсключение "Невозможно провести посещение: абонемент клиента закончился.";
			КонецЕсли;

			ДвижениеОстатки = Новый Структура("ВидДвижения, АбонементКлиента, КоличествоЗанятий");
			ДвижениеОстатки.ВидДвижения = ВидДвиженияНакопления.Расход;
			ДвижениеОстатки.АбонементКлиента = СтрокаУчастников.Абонемент;
			ДвижениеОстатки.КоличествоЗанятий = 1;
			ДвиженияОстатки.Добавить(ДвижениеОстатки);

			Движение.Списано = 1;
		КонецЕсли;
	КонецЦикла;

	НаборЗаписейПосещения.Записать();

	Если ДвиженияОстатки.Количество() > 0 Тогда
		РаботаСОстаткамиАбонементов.ЗаписатьДвиженияОстатки(Ссылка, Дата, ДвиженияОстатки);
		// Обновление денормализованных полей абонементов
		СписокАбонементов = Новый Массив;
		Для Каждого ДвижениеОстатки ИЗ ДвиженияОстатки Цикл
			Если СписокАбонементов.Найти(ДвижениеОстатки.АбонементКлиента) = Неопределено Тогда
				СписокАбонементов.Добавить(ДвижениеОстатки.АбонементКлиента);
			КонецЕсли;
		КонецЦикла;
		Для Каждого АбонементКлиента ИЗ СписокАбонементов Цикл
			РаботаСОстаткамиАбонементов.ОбновитьИспользованоПоАбонементу(АбонементКлиента);
		КонецЦикла;
	КонецЕсли;

	ЗанятиеОбъект.Записать();
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	ЗанятиеОбъект = Занятие.ПолучитьОбъект();
	ЗанятиеОбъект.Статус = Перечисления.СтатусыЗанятия.Запланировано;
	Для Каждого УчастникЗанятия ИЗ ЗанятиеОбъект.Участники Цикл
		УчастникЗанятия.СтатусПосещения = Перечисления.СтатусыПосещения.Отсутствовал;
	КонецЦикла;
	ЗанятиеОбъект.Записать();

	// Возврат списанных занятий на баланс
	ОтборОстатки = Новый Структура("Регистратор", Ссылка);
	ЗаписиОстатки = РегистрыНакопления.ОстаткиАбонементов.СоздатьНаборЗаписей();
	ЗаписиОстатки.Отбор.Регистратор.Установить(Ссылка);
	ЗаписиОстатки.Прочитать();
	Для Каждого Запись ИЗ ЗаписиОстатки Цикл
		Если Запись.ВидДвижения = ВидДвиженияНакопления.Расход Тогда
			РаботаСОстаткамиАбонементов.ОбновитьИспользованоПоАбонементу(Запись.АбонементКлиента);
		КонецЕсли;
	КонецЦикла;
	ОтборОстатки.Вставить("ВидДвижения", ВидДвиженияНакопления.Расход);
	РаботаСОстаткамиАбонементов.ОбновитьИспользованоПоАбонементу(Справочники.АбонементыКлиента.ПустаяСсылка());
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	Если ПустоеЗначение(Занятие) Тогда
		Сообщить("Не указано занятие");
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры
