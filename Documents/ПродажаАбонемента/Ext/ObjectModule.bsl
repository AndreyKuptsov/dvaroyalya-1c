// Модуль документа Продажа абонемента

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	// Создание абонемента клиента
	НовыйАбонемент = Справочники.АбонементыКлиента.СоздатьЭлемент();
	НовыйАбонемент.Наименование = Строка(Клиент) + " / " + Строка(Абонемент);
	НовыйАбонемент.Клиент = Клиент;
	НовыйАбонемент.ВидАбонемента = Абонемент;
	НовыйАбонемент.ДатаПокупки = ТекущаяДата();
	НовыйАбонемент.ДатаНачалаДействия = ДатаНачала;
	НовыйАбонемент.ДатаОкончания = ДатаОкончания;
	НовыйАбонемент.КоличествоЗанятий = Абонемент.КоличествоЗанятий;
	НовыйАбонемент.Использовано = 0;
	НовыйАбонемент.Статус = Перечисления.СтатусыАбонементаКлиента.Активен;
	НовыйАбонемент.ПроданоПоДокументу = Ссылка;
	НовыйАбонемент.Записать();

	// Зачисление занятий на баланс абонемента (движение Приход по регистру ОстаткиАбонементов)
	ДвиженияОстатки = Новый Массив;
	ДвижениеОстатки = Новый Структура("ВидДвижения, АбонементКлиента, КоличествоЗанятий");
	ДвижениеОстатки.ВидДвижения = ВидДвиженияНакопления.Приход;
	ДвижениеОстатки.АбонементКлиента = НовыйАбонемент.Ссылка;
	ДвижениеОстатки.КоличествоЗанятий = Абонемент.КоличествоЗанятий;
	ДвиженияОстатки.Добавить(ДвижениеОстатки);
	РаботаСОстаткамиАбонементов.ЗаписатьДвиженияОстатки(Ссылка, Дата, ДвиженияОстатки);

	// Регистрация оплаты
	Оплата = Документы.Оплата.СоздатьДокумент();
	Оплата.Дата = ТекущаяДата();
	Оплата.Клиент = Клиент;
	Оплата.Сумма = Стоимость;
	Оплата.СпособОплаты = СпособОплаты;
	Оплата.Назначение = Перечисления.ВидыОперацийОплат.ПокупкаАбонемента;
	Оплата.Абонемент = НовыйАбонемент.Ссылка;
	Оплата.Записать(РежимЗаписиДокумента.Проведение);

	АудитДействий.ЗарегистрироватьИзменение(ЭтотОбъект, "Продажа абонемента", "", Строка(Абонемент) + ", сумма=" + Строка(Стоимость));
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	Если ПустоеЗначение(Клиент) Тогда
		Сообщить("Не заполнен клиент");
		Отказ = Истина;
	КонецЕсли;
	Если ПустоеЗначение(Абонемент) Тогда
		Сообщить("Не выбран вид абонемента");
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры
