// Модуль документа Возврат

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	// Регистрация возврата как обратного движения по оплатам
	НаборЗаписей = РегистрыНакопления.Оплаты.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(Ссылка);
	НаборЗаписей.Записать();

	Движение = НаборЗаписей.Добавить();
	Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
	Движение.Период = Дата;
	Движение.Клиент = Клиент;
	Движение.Абонемент = Абонемент;
	Движение.Назначение = Перечисления.ВидыОперацийОплат.Возврат;
	Движение.Сумма = Сумма;
	Движение.КоличествоОплат = 1;

	НаборЗаписей.Записать();

	// Если абонемент возвращён полностью - статус "Отменён" и списание остатка
	Если Не ПустоеЗначение(Абонемент) Тогда
		АбКлиента = Абонемент.ПолучитьОбъект();
		Остаток = РаботаСОстаткамиАбонементов.ОстатокЗанятийПоАбонементу(АбКлиента.Ссылка);
		Если Остаток > 0 Тогда
			ДвиженияОстатки = Новый Массив;
			ДвижениеОстатки = Новый Структура("ВидДвижения, АбонементКлиента, КоличествоЗанятий");
			ДвижениеОстатки.ВидДвижения = ВидДвиженияНакопления.Расход;
			ДвижениеОстатки.АбонементКлиента = АбКлиента.Ссылка;
			ДвижениеОстатки.КоличествоЗанятий = Остаток;
			ДвиженияОстатки.Добавить(ДвижениеОстатки);
			РаботаСОстаткамиАбонементов.ЗаписатьДвиженияОстатки(Ссылка, Дата, ДвиженияОстатки);
		КонецЕсли;
		АбКлиента.Статус = Перечисления.СтатусыАбонементаКлиента.Отменён;
		АбКлиента.Записать();
	КонецЕсли;

	АудитДействий.ЗарегистрироватьИзменение(ЭтотОбъект, "Возврат", "", "Клиент=" + Строка(Клиент) + ", Сумма=" + Строка(Сумма));
КонецПроцедуры
