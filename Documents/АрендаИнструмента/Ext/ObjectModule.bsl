// Модуль документа Аренда инструмента

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	// Контроль доступности инструмента на выбранный период
	Если НЕ КонтрольКонфликтовРасписания.ПроверитьДоступностьИнструмента(Инструмент, ВремяНачала, ВремяОкончания, Ссылка) Тогда
		ВызватьИсключение "Невозможно провести аренду: инструмент недоступен в выбранный период.";
	КонецЕсли;

	// Движение по регистру АрендыИнструментов (учёт выручки и часов аренды)
	НаборЗаписей = РегистрыНакопления.АрендыИнструментов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(Ссылка);
	НаборЗаписей.Записать();

	Движение = НаборЗаписей.Добавить();
	Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
	Движение.Период = Дата;
	Движение.Инструмент = Инструмент;
	Движение.Клиент = Клиент;
	Движение.Филиал = Инструмент.Филиал;
	Движение.Стоимость = Стоимость;
	Движение.КоличествоЧасов = Цел((ВремяОкончания - ВремяНачала) / 3600);

	НаборЗаписей.Записать();

	// Помечаем инструмент как забронированный
	ИнструментОбъект = Инструмент.ПолучитьОбъект();
	ИнструментОбъект.Статус = Перечисления.СтатусыИнструмента.Забронирован;
	ИнструментОбъект.Записать();

	// Регистрация оплаты аренды
	Оплата = Документы.Оплата.СоздатьДокумент();
	Оплата.Дата = ТекущаяДата();
	Оплата.Клиент = Клиент;
	Оплата.Сумма = Стоимость;
	Оплата.Назначение = Перечисления.ВидыОперацийОплат.ДополнительнаяУслуга;
	Оплата.Комментарий = "Аренда инструмента: " + Строка(Инструмент);
	Оплата.Записать(РежимЗаписиДокумента.Проведение);

	АудитДействий.ЗарегистрироватьИзменение(ЭтотОбъект, "Аренда инструмента", "", Строка(Инструмент) + ", сумма=" + Строка(Стоимость));
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	Если ПустоеЗначение(Клиент) Тогда
		Сообщить("Не заполнен клиент");
		Отказ = Истина;
	КонецЕсли;
	Если ПустоеЗначение(Инструмент) Тогда
		Сообщить("Не выбран инструмент");
		Отказ = Истина;
	КонецЕсли;
	Если ВремяОкончания <= ВремяНачала Тогда
		Сообщить("Время окончания должно быть позже времени начала");
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры
