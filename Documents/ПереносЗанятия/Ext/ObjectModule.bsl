// Модуль документа Перенос занятия

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	// 1. Первоначальное занятие -> статус "Перенесено"
	Первоначальное = ПервоначальноеЗанятие.ПолучитьОбъект();
	Первоначальное.Статус = Перечисления.СтатусыЗанятия.Перенесено;
	Первоначальное.Записать();

	// 2. Создание нового занятия и перенос клиентов
	Новое = Документы.Занятие.СоздатьДокумент();
	Новое.Дата = НоваяДата;
	Новое.ДатаЗанятия = НоваяДата;
	Новое.ВремяНачала = НовоеВремяНачала;
	Новое.ВремяОкончания = НовоеВремяОкончания;
	Новое.Преподаватель = Первоначальное.Преподаватель;
	Новое.Аудитория = Первоначальное.Аудитория;
	Новое.Направление = Первоначальное.Направление;
	Новое.ТипЗанятия = Первоначальное.ТипЗанятия;
	Новое.Статус = Перечисления.СтатусыЗанятия.Запланировано;
	Новое.Комментарий = "Перенесено из " + Строка(ПервоначальноеЗанятие) + ". Причина: " + ПричинаПереноса;

	Для Каждого Участник ИЗ Первоначальное.Участники Цикл
		НовыйУчастник = Новое.Участники.Добавить();
		НовыйУчастник.Клиент = Участник.Клиент;
		НовыйУчастник.Абонемент = Участник.Абонемент;
	КонецЦикла;

	Новое.Записать(РежимЗаписиДокумента.Проведение);

	// 3. Связь между первоначальным и новым занятием
	НовыйОбъект = Новое.ПолучитьОбъект();
	НовыйОбъект.Комментарий = НовыйОбъект.Комментарий;
	НовыйОбъект.Записать();

	НовоеЗанятие = Новое.Ссылка;

	АудитДействий.ЗарегистрироватьИзменение(ЭтотОбъект, "Перенос занятия",
		Строка(ПервоначальноеЗанятие), Строка(НовоеЗанятие));
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	Если ПустоеЗначение(ПервоначальноеЗанятие) Тогда
		Сообщить("Не указано первоначальное занятие");
		Отказ = Истина;
	КонецЕсли;
	Если Не ПустоеЗначение(НоваяДата) И (НовоеВремяОкончания <= НовоеВремяНачала) Тогда
		Сообщить("Некорректное время нового занятия");
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры
