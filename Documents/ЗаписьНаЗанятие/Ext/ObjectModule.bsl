// Модуль документа Запись на занятие

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	// Автоматическая проверка наличия действующего абонемента
	Если ПустоеЗначение(Абонемент) Тогда
		Абонемент = РаботаСОстаткамиАбонементов.АктивныйАбонементКлиента(Клиент);
	КонецЕсли;

	Если ПустоеЗначение(Абонемент) Тогда
		ВызватьИсключение "Невозможно создать запись: у клиента отсутствует действующий абонемент.";
	КонецЕсли;

	Если РаботаСОстаткамиАбонементов.ОстатокЗанятийПоАбонементу(Абонемент) <= 0 Тогда
		ВызватьИсключение "Невозможно создать запись: абонемент клиента закончился.";
	КонецЕсли;

	// Добавляем клиента в участники занятия
	ЗанятиеОбъект = Занятие.ПолучитьОбъект();
	УжеЗаписан = Ложь;
	Для Каждого СтрокаУчастников ИЗ ЗанятиеОбъект.Участники Цикл
		Если СтрокаУчастников.Клиент = Клиент Тогда
			УжеЗаписан = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Не УжеЗаписан Тогда
		НоваяСтрока = ЗанятиеОбъект.Участники.Добавить();
		НоваяСтрока.Клиент = Клиент;
		НоваяСтрока.Абонемент = Абонемент;
		НоваяСтрока.СтатусПосещения = Перечисления.СтатусыПосещения.Отсутствовал;
		ЗанятиеОбъект.Записать();
	КонецЕсли;

	АудитДействий.ЗарегистрироватьИзменение(ЭтотОбъект, "Запись клиента", "", Строка(Клиент));
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	Если ПустоеЗначение(Клиент) Тогда
		Сообщить("Не заполнен клиент");
		Отказ = Истина;
	КонецЕсли;
	Если ПустоеЗначение(Занятие) Тогда
		Сообщить("Не выбрано занятие");
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры
