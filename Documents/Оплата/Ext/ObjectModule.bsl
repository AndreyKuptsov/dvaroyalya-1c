// Модуль документа Оплата

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	// Регистрация оплаты в регистре накопления Оплаты
	НаборЗаписей = РегистрыНакопления.Оплаты.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(Ссылка);
	НаборЗаписей.Записать();

	Движение = НаборЗаписей.Добавить();
	Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
	Движение.Период = Дата;
	Движение.Клиент = Клиент;
	Движение.Абонемент = Абонемент;
	Движение.Назначение = Назначение;
	Движение.Сумма = Сумма;
	Движение.КоличествоОплат = 1;

	НаборЗаписей.Записать();

	АудитДействий.ЗарегистрироватьИзменение(ЭтотОбъект, "Оплата", "", "Клиент=" + Строка(Клиент) + ", Сумма=" + Строка(Сумма));
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	Если ПустоеЗначение(Клиент) Тогда
		Сообщить("Не заполнен клиент");
		Отказ = Истина;
	КонецЕсли;
	Если Сумма <= 0 Тогда
		Сообщить("Сумма должна быть больше нуля");
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры
