// Модуль документа Занятие

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	Если ТипЗнч(ДанныеЗаполнения) = Тип("СправочникСсылка.Преподаватели") Тогда
		Преподаватель = ДанныеЗаполнения;
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	// Контроль конфликтов перед проведением
	Конфликты = КонтрольКонфликтовРасписания.ПроверитьЗанятие(ЭтотОбъект);
	Если Конфликты.Количество() > 0 Тогда
		Текст = "Невозможно провести занятие:" + Символы.ПС;
		Для Каждого К из Конфликты Цикл
			Текст = Текст + К + Символы.ПС;
		КонецЦикла;
		ВызватьИсключение Текст;
	КонецЕсли;

	// Движения по загрузке преподавателя
	НаборЗаписей = РегистрыНакопления.ЗагрузкаПреподавателей.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(Ссылка);
	НаборЗаписей.Записать();

	Движение = НаборЗаписей.Добавить();
	Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
	Движение.Период = Дата;
	Движение.Преподаватель = Преподаватель;
	Движение.Часы = (ВремяОкончания - ВремяНачала) / 60;

	// Движения по загрузке аудитории
	Если Не ПустоеЗначение(Аудитория) Тогда
		НаборЗаписейАуд = РегистрыНакопления.ЗагрузкаАудиторий.СоздатьНаборЗаписей();
		НаборЗаписейАуд.Отбор.Регистратор.Установить(Ссылка);
		НаборЗаписейАуд.Записать();
		ДвижениеАуд = НаборЗаписейАуд.Добавить();
		ДвижениеАуд.ВидДвижения = ВидДвиженияНакопления.Приход;
		ДвижениеАуд.Период = Дата;
		ДвижениеАуд.Аудитория = Аудитория;
		ДвижениеАуд.Часы = (ВремяОкончания - ВремяНачала) / 60;
	КонецЕсли;

	НаборЗаписей.Записать();
КонецПроцедуры

Процедура ОбработкаУстановкиНовогоНомера(СтандартнаяОбработка, Префикс)
КонецПроцедуры

Процедура УдалениеПроведения(Отказ)
КонецПроцедуры

Процедура ОбработкаУдаления(Отказ)
	// Запись в аудит
	АудитДействий.ЗарегистрироватьИзменение(ЭтотОбъект, "Изменение расписания", "", Строка(Статус));
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	Если ПустоеЗначение(Преподаватель) Тогда
		Сообщить("Не заполнен преподаватель");
		Отказ = Истина;
	КонецЕсли;
	Если ПустоеЗначение(ВремяНачала) Тогда
		Сообщить("Не заполнено время начала");
		Отказ = Истина;
	КонецЕсли;
	Если ВремяОкончания <= ВремяНачала Тогда
		Сообщить("Время окончания должно быть позже времени начала");
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаЗаписиНового(Отказ)
КонецПроцедуры
