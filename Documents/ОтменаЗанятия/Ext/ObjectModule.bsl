// Модуль документа Отмена занятия

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	ЗанятиеОбъект = Занятие.ПолучитьОбъект();
	ЗанятиеОбъект.Статус = Перечисления.СтатусыЗанятия.Отменено;
	ЗанятиеОбъект.Записать();

	// Возврат занятий на баланс абонемента
	Если ВозвращатьЗанятие Тогда
		ДвиженияОстатки = Новый Массив;
		СписокАбонементов = Новый Массив;
		Для Каждого Участник ИЗ ЗанятиеОбъект.Участники Цикл
			Если Не ПустоеЗначение(Участник.Абонемент) И Участник.СтатусПосещения = Перечисления.СтатусыПосещения.Присутствовал Тогда
				ДвижениеОстатки = Новый Структура("ВидДвижения, АбонементКлиента, КоличествоЗанятий");
				ДвижениеОстатки.ВидДвижения = ВидДвиженияНакопления.Приход;
				ДвижениеОстатки.АбонементКлиента = Участник.Абонемент;
				ДвижениеОстатки.КоличествоЗанятий = 1;
				ДвиженияОстатки.Добавить(ДвижениеОстатки);
				Если СписокАбонементов.Найти(Участник.Абонемент) = Неопределено Тогда
					СписокАбонементов.Добавить(Участник.Абонемент);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Если ДвиженияОстатки.Количество() > 0 Тогда
			РаботаСОстаткамиАбонементов.ЗаписатьДвиженияОстатки(Ссылка, Дата, ДвиженияОстатки);
			Для Каждого АбонементКлиента ИЗ СписокАбонементов Цикл
				РаботаСОстаткамиАбонементов.ОбновитьИспользованоПоАбонементу(АбонементКлиента);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

	АудитДействий.ЗарегистрироватьИзменение(ЭтотОбъект, "Отмена занятия", "", "Причина=" + Строка(Причина));
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	Если ПустоеЗначение(Занятие) Тогда
		Сообщить("Не указано занятие");
		Отказ = Истина;
	КонецЕсли;
	Если ПустоеЗначение(Причина) Тогда
		Сообщить("Не указана причина отмены");
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры
