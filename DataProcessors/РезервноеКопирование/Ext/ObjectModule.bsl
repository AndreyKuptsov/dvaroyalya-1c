// Обработка Резервное копирование информационной базы

Процедура ВыполнитьРезервноеКопирование(Команда)
	Если ПустаяСтрока(КаталогРезервныхКопий) Тогда
		Предупреждение("Не указан каталог резервных копий.");
		Возврат;
	КонецЕсли;

	ИмяФайла = КаталогРезервныхКопий + "ДваРояля_" + Формат(ТекущаяДата(), "ДФ=ddMMyyyy_hhmmss") + ".dt";

	БД = Новый Криптография;
	// Использование сервера 1С:Предприятие для выгрузки базы
	ОбработкаОбъект = Обработки.РезервноеКопирование.Создать();

	СистемнаяИнформация = Новый СистемнаяИнформация;
	Если СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Windows_x86
		ИЛИ СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Windows_x86_64 Тогда
		СтрокаЗапуска = "1cv8.exe DESIGNER /F /DumpIB " + ИмяФайла;
	Иначе
		СтрокаЗапуска = "1cv8 DESIGNER /F /DumpIB " + ИмяФайла;
	КонецЕсли;

	ЗапуститьПриложение(СтрокаЗапуска, КаталогРезервныхКопий, Ложь);

	Если ФС.СуществуетФайл(ИмяФайла) Тогда
		АудитДействий.ЗарегистрироватьИзменение("Резервное копирование", "Создание копии", "", ИмяФайла);
		Предупреждение("Резервная копия создана: " + ИмяФайла);
	Иначе
		Предупреждение("Не удалось создать резервную копию.");
	КонецЕсли;
КонецПроцедуры
