// Обработка Импорт данных (Клиенты, Преподаватели, Направления, Абонементы, Расписание, История посещений)

// Чтение из JSON/CSV/XML и загрузка справочников
Процедура ВыполнитьИмпорт(Команда)
	// Проверка обязательных полей
	Если ПустаяСтрока(ФайлДанных) Тогда
		Предупреждение("Не указан файл данных.");
		Возврат;
	КонецЕсли;

	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(ФайлДанных);
	Данные = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();

	Если ТипДанных = "Клиенты" Тогда
		ЗагрузитьКлиентов(Данные);
	ИначеЕсли ТипДанных = "Преподаватели" Тогда
		ЗагрузитьПреподавателей(Данные);
	ИначеЕсли ТипДанных = "Направления" Тогда
		ЗагрузитьНаправления(Данные);
	ИначеЕсли ТипДанных = "Абонементы" Тогда
		ЗагрузитьАбонементы(Данные);
	ИначеЕсли ТипДанных = "Расписание" Тогда
		ЗагрузитьРасписание(Данные);
	КонецЕсли;

	Предупреждение("Импорт завершён успешно.");
КонецПроцедуры

Процедура ЗагрузитьКлиентов(Данные)
	Для Каждого Элемент ИЗ Данные Цикл
		Клиент = Справочники.Клиенты.НайтиПоРеквизиту("Телефон", Элемент.Телефон);
		Если Клиент.Пустая() Тогда
			Клиент = Справочники.Клиенты.СоздатьЭлемент();
		КонецЕсли;
		Клиент.Наименование = Элемент.ФИО;
		Клиент.Телефон = Элемент.Телефон;
		Клиент.Email = Элемент.Email;
		Клиент.Telegram = Элемент.Telegram;
		Если ПустоеЗначение(Клиент.ДатаРегистрации) Тогда
			Клиент.ДатаРегистрации = ТекущаяДата();
		КонецЕсли;
		Если ПустоеЗначение(Клиент.СтатусКлиента) Тогда
			Клиент.СтатусКлиента = Перечисления.СтатусыКлиентов.Активный;
		КонецЕсли;
		Клиент.Записать();
	КонецЦикла;
КонецПроцедуры

Процедура ЗагрузитьПреподавателей(Данные)
	Для Каждого Элемент ИЗ Данные Цикл
		Преподаватель = Справочники.Преподаватели.СоздатьЭлемент();
		Преподаватель.Наименование = Элемент.ФИО;
		Преподаватель.Телефон = Элемент.Телефон;
		Преподаватель.Email = Элемент.Email;
		Преподаватель.Специализация = Элемент.Специализация;
		Преподаватель.Статус = Перечисления.СтатусыПреподавателей.Работает;
		Преподаватель.Записать();
	КонецЦикла;
КонецПроцедуры

Процедура ЗагрузитьНаправления(Данные)
	Для Каждого Элемент ИЗ Данные Цикл
		Направление = Справочники.Направления.СоздатьЭлемент();
		Направление.Наименование = Элемент.Наименование;
		Направление.ДлительностьЗанятия = Элемент.Длительность;
		Направление.БазоваяСтоимость = Элемент.Стоимость;
		Направление.Активность = Истина;
		Направление.Записать();
	КонецЦикла;
КонецПроцедуры

Процедура ЗагрузитьАбонементы(Данные)
	Для Каждого Элемент ИЗ Данные Цикл
		Абонемент = Справочники.Абонементы.СоздатьЭлемент();
		Абонемент.Наименование = Элемент.Наименование;
		Абонемент.КоличествоЗанятий = Элемент.КоличествоЗанятий;
		Абонемент.СрокДействия = Элемент.СрокДействия;
		Абонемент.Стоимость = Элемент.Стоимость;
		Абонемент.Активность = Истина;
		Абонемент.Записать();
	КонецЦикла;
КонецПроцедуры

Процедура ЗагрузитьРасписание(Данные)
	Для Каждого Элемент ИЗ Данные Цикл
		Занятие = Документы.Занятие.СоздатьДокумент();
		Занятие.Дата = Элемент.Дата;
		Занятие.ДатаЗанятия = Элемент.Дата;
		Занятие.Преподаватель = Элемент.Преподаватель;
		Занятие.Аудитория = Элемент.Аудитория;
		Занятие.Направление = Элемент.Направление;
		Занятие.Статус = Перечисления.СтатусыЗанятия.Запланировано;
		Занятие.Записать();
	КонецЦикла;
КонецПроцедуры
