// Обработка Отправка уведомлений клиентам
// - напоминание за 24 часа и за 2 часа
// - уведомление об отмене/переносе
// - о низком остатке и окончании абонемента

Процедура ОтправитьНапоминания(Команда)
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Занятия.Участники.Клиент КАК Клиент,
		|	Занятия.Дата КАК Дата,
		|	Занятия.ВремяНачала КАК ВремяНачала
		|ИЗ
		|	Документ.Занятие КАК Занятия
		|ГДЕ
		|	Занятия.ВремяНачала МЕЖДУ &От И &До
		|	И Занятия.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЗанятия.Подтверждено)";
	Запрос.УстановитьПараметр("От", ТекущаяДата() + 23 * 3600);
	Запрос.УстановитьПараметр("До", ТекущаяДата() + 25 * 3600);

	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		Текст = "Напоминание: занятие " + Формат(Выборка.Дата, "ДЛФ=DD") + " в " + Формат(Выборка.ВремяНачала, "ДФ=HH:mm");
		УведомленияСервер.ОтправитьУведомление(Выборка.Клиент, "Напоминание24часа", Текст);
	КонецЦикла;
КонецПроцедуры

Процедура УведомитьОкончаниеАбонементов(Команда)
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	АбонементыКлиента.Клиент КАК Клиент,
		|	АбонементыКлиента.ВидАбонемента КАК ВидАбонемента,
		|	АбонементыКлиента.КоличествоЗанятий - АбонементыКлиента.Использовано КАК Остаток
		|ИЗ
		|	Справочник.АбонементыКлиента КАК АбонементыКлиента
		|ГДЕ
		|	АбонементыКлиента.ДатаОкончания <= &Граница
		|	И АбонементыКлиента.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыАбонементаКлиента.Активен)";
	Запрос.УстановитьПараметр("Граница", ТекущаяДата() + 7 * 86400);
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		Текст = "Ваш абонемент заканчивается. Остаток занятий: " + Выборка.Остаток;
		УведомленияСервер.ОтправитьУведомление(Выборка.Клиент, "ОкончаниеАбонемента", Текст);
	КонецЦикла;
КонецПроцедуры
