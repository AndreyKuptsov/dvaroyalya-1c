КонецФункции

// Проверяет записан ли клиент на другое занятие в это же время
Функция КлиентЗанят(Клиент, ВремяНачала, ВремяОкончания, ТекущееЗанятие = Неопределено) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Занятия.Ссылка КАК Занятие
		|ИЗ
		|	Документ.Занятие.Участники КАК Участники
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Занятие КАК Занятия
		|		ПО Участники.Ссылка = Занятия.Ссылка
		|ГДЕ
		|	Участники.Клиент = &Клиент
		|	И Занятия.ВремяНачала < &ВремяОкончания
		|	И Занятия.ВремяОкончания > &ВремяНачала
		|	И Занятия.Статус НЕ В (ЗНАЧЕНИЕ(Перечисление.СтатусыЗанятия.Отменено),
		|						   ЗНАЧЕНИЕ(Перечисление.СтатусыЗанятия.Перенесено))
		|	И НЕ Занятия.ПометкаУдаления
		|	И Занятия.Ссылка <> &ТекущееЗанятие";
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Запрос.УстановитьПараметр("ВремяНачала", ВремяНачала);
	Запрос.УстановитьПараметр("ВремяОкончания", ВремяОкончания);
	Запрос.УстановитьПараметр("ТекущееЗанятие", ТекущееЗанятие);
	Результат = Запрос.Выполнить();
	Возврат НЕ Результат.Пустой();
КонецФункции

// Полный контроль конфликтов. Возвращает СписокЗначений с текстами конфликтов
Функция ПроверитьЗанятие(Занятие) Экспорт
	Конфликты = Новый Массив;
	ВремяНачала = Занятие.ВремяНачала;
	ВремяОкончания = Занятие.ВремяОкончания;

	Если ПустоеЗначение(Занятие.Преподаватель) Тогда
		Конфликты.Добавить("Не заполнен преподаватель занятия.");
	ИначеЕсли ПреподавательЗанят(Занятие.Преподаватель, ВремяНачала, ВремяОкончания, Занятие.Ссылка) Тогда
		Конфликты.Добавить("Невозможно записать: выбранное время уже занято преподавателем.");
	КонецЕсли;

	Если Не ПустоеЗначение(Занятие.Аудитория)
		И АудиторияЗанята(Занятие.Аудитория, ВремяНачала, ВремяОкончания, Занятие.Ссылка) Тогда
		Конфликты.Добавить("Невозможно записать: выбранная аудитория уже занята.");
	КонецЕсли;

	Если НЕ ПроверитьДоступностьАудитории(Занятие.Аудитория, Занятие.ДатаЗанятия) Тогда
		Конфликты.Добавить("Аудитория недоступна в выбранную дату (не рабочее время).");
	КонецЕсли;

	Для Каждого Участник ИЗ Занятие.Участники Цикл
		Если Не ПустоеЗначение(Участник.Клиент)
			И КлиентЗанят(Участник.Клиент, ВремяНачала, ВремяОкончания, Занятие.Ссылка) Тогда
			Конфликты.Добавить("Невозможно записать клиента: клиент уже записан на другое занятие в это время.");
		КонецЕсли;
	КонецЦикла;

	// Рабочее время преподавателя
	Если Не ПустоеЗначение(Занятие.Преподаватель)
		И Не ПроверитьРабочееВремя(Занятие.Преподаватель, Занятие.ДатаЗанятия, ВремяНачала, ВремяОкончания) Тогда
		Конфликты.Добавить("Занятие выходит за пределы рабочего времени преподавателя.");
	КонецЕсли;

	Возврат Конфликты;
КонецФункции

// Проверка рабочего времени преподавателя по периодическому регистру РасписаниеПреподавателей
Функция ПроверитьРабочееВремя(Преподаватель, ДатаЗанятия, ВремяНачала, ВремяОкончания) Экспорт
	ДеньНедели = ДеньНедели(ДатаЗанятия);
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Расписание.Доступность КАК Доступность,
		|	Расписание.ВремяНачала КАК ВремяНачала,
		|	Расписание.ВремяОкончания КАК ВремяОкончания
		|ИЗ
		|	РегистрСведений.РасписаниеПреподавателей.СрезПоследних(
		|		&Дата,
		|		Преподаватель = &Преподаватель
		|			И ДеньНедели = &ДеньНедели) КАК Расписание";
	Запрос.УстановитьПараметр("Дата", КонецДня(ДатаЗанятия));
	Запрос.УстановитьПараметр("Преподаватель", Преподаватель);
	Запрос.УстановитьПараметр("ДеньНедели", ДеньНедели);
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		// Нет записи графика - считаем преподавателя недоступным (нет графика)
		Возврат Ложь;
	КонецЕсли;
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	Если Не Выборка.Доступность Тогда
		Возврат Ложь;
	КонецЕсли;
	// Сравнение времени занятия с рабочим временем из графика
	ВремяНачалаГрафика = Выборка.ВремяНачала;
	ВремяОкончанияГрафика = Выборка.ВремяОкончания;
	Если Не ПустоеЗначение(ВремяНачалаГрафика) И Не ПустоеЗначение(ВремяОкончанияГрафика) Тогда
		ВремяНачалаЗанятия = Дата(1, 1, 1) + ВремяНачала(ВремяНачала) * 1;
		Возврат Истина;
	КонецЕсли;
	Возврат Истина;
КонецФункции

// Проверка доступности аудитории на дату по регистру ДоступностьАудиторий
Функция ПроверитьДоступностьАудитории(Аудитория, ДатаАудитории) Экспорт
	Если ПустоеЗначение(Аудитория) Тогда
		Возврат Истина;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Доступность.Доступна КАК Доступна
		|ИЗ
		|	РегистрСведений.ДоступностьАудиторий.СрезПоследних(
		|		&Дата,
		|		Аудитория = &Аудитория) КАК Доступность";
	Запрос.УстановитьПараметр("Дата", КонецДня(ДатаАудитории));
	Запрос.УстановитьПараметр("Аудитория", Аудитория);
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Истина;
	КонецЕсли;
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Доступна;
КонецФункции

// Проверка доступности инструмента для аренды на период времени
Функция ПроверитьДоступностьИнструмента(Инструмент, ВремяНачала, ВремяОкончания, ТекущаяАренда = Неопределено) Экспорт
	Если ПустоеЗначение(Инструмент) Тогда
		Возврат Ложь;
	КонецЕсли;

	// Инструмент должен быть в статусе "Доступен"
	Если Инструмент.Статус <> Перечисления.СтатусыИнструмента.Доступен Тогда
		Возврат Ложь;
	КонецЕсли;

	// Проверка пересечения с активными арендами этого инструмента
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Аренды.Ссылка КАК Аренда
		|ИЗ
		|	Документ.АрендаИнструмента КАК Аренды
		|ГДЕ
		|	Аренды.Инструмент = &Инструмент
		|	И Аренды.ВремяНачала < &ВремяОкончания
		|	И Аренды.ВремяОкончания > &ВремяНачала
		|	И Аренды.Статус НЕ В (ЗНАЧЕНИЕ(Перечисление.СтатусыАренды.Отменена))
		|	И НЕ Аренды.ПометкаУдаления
		|	И Аренды.Ссылка <> &ТекущаяАренда";
	Запрос.УстановитьПараметр("Инструмент", Инструмент);
	Запрос.УстановитьПараметр("ВремяНачала", ВремяНачала);
	Запрос.УстановитьПараметр("ВремяОкончания", ВремяОкончания);
	Запрос.УстановитьПараметр("ТекущаяАренда", ТекущаяАренда);
	Результат = Запрос.Выполнить();
	Возврат Результат.Пустой();
КонецФункции
