// Контроль конфликтов расписания при создании/изменении занятий

// Проверяет занят ли преподаватель в указанный период
Функция ПреподавательЗанят(Преподаватель, ВремяНачала, ВремяОкончания, ТекущееЗанятие = Неопределено) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Занятия.Ссылка КАК Занятие
		|ИЗ
		|	Документ.Занятие КАК Занятия
		|ГДЕ
		|	Занятия.Преподаватель = &Преподаватель
		|	И Занятия.ВремяНачала < &ВремяОкончания
		|	И Занятия.ВремяОкончания > &ВремяНачала
		|	И Занятия.Статус НЕ В (ЗНАЧЕНИЕ(Перечисление.СтатусыЗанятия.Отменено),
		|						   ЗНАЧЕНИЕ(Перечисление.СтатусыЗанятия.Перенесено),
		|						   ЗНАЧЕНИЕ(Перечисление.СтатусыЗанятия.НеСостоялось))
		|	И НЕ Занятия.ПометкаУдаления
		|	И Занятия.Ссылка <> &ТекущееЗанятие";
	Запрос.УстановитьПараметр("Преподаватель", Преподаватель);
	Запрос.УстановитьПараметр("ВремяНачала", ВремяНачала);
	Запрос.УстановитьПараметр("ВремяОкончания", ВремяОкончания);
	Запрос.УстановитьПараметр("ТекущееЗанятие", ТекущееЗанятие);
	Результат = Запрос.Выполнить();
	Возврат НЕ Результат.Пустой();
КонецФункции

// Проверяет занята ли аудитория
