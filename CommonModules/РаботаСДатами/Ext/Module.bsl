// Общие функции работы с датами

Функция НачалоДня(ДатаВремя) Экспорт
	Возврат Дата(Год(ДатаВремя), Месяц(ДатаВремя), День(ДатаВремя));
КонецФункции

Функция КонецДня(ДатаВремя) Экспорт
	Возврат Дата(Год(ДатаВремя), Месяц(ДатаВремя), День(ДатаВремя), 23, 59, 59);
КонецФункции

// Заголовок дня недели: Понедельник(2) ... Воскресенье(1)
Функция НомерДняНедели(ДатаВремя) Экспорт
	Возврат ДеньНедели(ДатаВремя);
КонецФункции

// Смещение даты на N дней
Функция ДобавитьДни(ДатаВремя, КоличествоДней) Экспорт
	Возврат Дата(Год(ДатаВремя), Месяц(ДатаВремя), День(ДатаВремя)) + КоличествоДней * 86400;
КонецФункции
