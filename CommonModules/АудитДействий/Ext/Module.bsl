// Запись истории изменений критичных операций

Процедура ЗарегистрироватьИзменение(Объект, Действие, СтароеЗначение = "", НовоеЗначение = "") Экспорт
	Запись = РегистрыСведений.ИсторияИзменений.СоздатьЗапись();
	Запись.Пользователь = ПараметрыСеанса.ТекущийПользователь;
	Запись.ДатаВремя = ТекущаяДата();
	Запись.Объект = Строка(Объект);
	Запись.Действие = Действие;
	Запись.СтароеЗначение = Строка(СтароеЗначение);
	Запись.НовоеЗначение = Строка(НовоеЗначение);
	НаборЗаписей = РегистрыСведений.ИсторияИзменений.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Пользователь.Установить(Запись.Пользователь);
	НаборЗаписей.Записать();
КонецПроцедуры
